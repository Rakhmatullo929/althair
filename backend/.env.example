# Django
DEBUG=true
SECRET_KEY=replace-with-a-long-random-development-value
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CLIENT_APP_URL=http://localhost:3001
DEFAULT_FROM_EMAIL=noreply@example.test
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
CLIENT_PORTAL_SEED_PASSWORD=development-only-change-me
ENABLE_CRM_TEST_CHANNEL=false
ADMIN_URL=admin/

# PostgreSQL / Redis
POSTGRES_NAME=aifo
POSTGRES_USER=aifo
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key

# Provider credentials and signatures (never commit populated values)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
AI_RUNTIME_PROVIDER=fake
AI_RUNTIME_ENABLE_REAL_OPENAI=false
AI_INTERNAL_TEST_AUTOPILOT=false
AI_MANUAL_GENERATION_PER_MINUTE=5
AI_MAX_TOOL_CALLS_PER_RUN=8
GEMINI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OUTLOOK_WEBHOOK_SECRET=
EXPECTED_API_TOKEN_SHA256=
EARLY_ACCESS_WEBHOOK_SECRET=replace-with-a-random-shared-secret

# Optional storage/monitoring
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
SENTRY_DSN=

# Development destination routing used by seed_dev_workspace
DEV_SMS_DESTINATION_ORG_A=+10000000001
DEV_SMS_DESTINATION_ORG_B=+10000000002
DEV_VOICE_DESTINATION_ORG_A=+10000000003
DEV_EMAIL_DESTINATION_ORG_A=inbox-a@example.test
