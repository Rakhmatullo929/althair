# Django
DEBUG=true
SECRET_KEY=replace-with-a-long-random-development-value
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_URL=admin/

# PostgreSQL / Redis
POSTGRES_NAME=aifo
POSTGRES_USER=aifo
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key

# Provider credentials and signatures (never commit populated values)
OPENAI_API_KEY=
GEMINI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OUTLOOK_WEBHOOK_SECRET=
EXPECTED_API_TOKEN_SHA256=
EARLY_ACCESS_WEBHOOK_SECRET=replace-with-a-random-shared-secret

# Optional storage/monitoring
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
SENTRY_DSN=

# Development destination routing used by seed_dev_workspace
DEV_SMS_DESTINATION_ORG_A=+10000000001
DEV_SMS_DESTINATION_ORG_B=+10000000002
DEV_VOICE_DESTINATION_ORG_A=+10000000003
DEV_EMAIL_DESTINATION_ORG_A=inbox-a@example.test
