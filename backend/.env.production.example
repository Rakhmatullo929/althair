# Copy to the repository root as .env.production and keep it mode 600.
# docker compose reads this file with: --env-file .env.production
DEBUG=false
SECRET_KEY=replace-with-at-least-64-random-characters
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://portal.example.com
CSRF_TRUSTED_ORIGINS=https://portal.example.com
CLIENT_APP_URL=https://portal.example.com
BACKEND_DOMAIN=https://api.example.com
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
ADMIN_URL=admin/

POSTGRES_NAME=althair
POSTGRES_USER=althair
POSTGRES_PASSWORD=replace-with-a-long-random-password
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key
EARLY_ACCESS_WEBHOOK_SECRET=replace-with-a-long-random-shared-secret

# Optional integrations. Leave blank until the corresponding provider is configured.
SENTRY_DSN=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
AI_RUNTIME_PROVIDER=fake
AI_RUNTIME_ENABLE_REAL_OPENAI=false
AI_RUNTIME_GLOBAL_KILL_SWITCH=false
AI_INTERNAL_TEST_AUTOPILOT=false
AI_MANUAL_GENERATION_PER_MINUTE=5
AI_MAX_TOOL_CALLS_PER_RUN=8
WEB_CHAT_ENABLE_PUBLIC=false
WEB_CHAT_GLOBAL_KILL_SWITCH=false
WEB_CHAT_ALLOW_FAKE_AUTOPILOT=false
WEB_CHAT_SESSION_SIGNING_KEY=replace-with-a-distinct-random-secret
