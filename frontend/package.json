{
  "name": "front-office-frontend",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@workspace/landing",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm --filter @workspace/landing test:e2e",
    "screenshots": "pnpm --filter @workspace/landing screenshots"
  },
  "devDependencies": {
    "prettier": "3.8.2",
    "prettier-plugin-tailwindcss": "0.7.2",
    "turbo": "2.10.9",
    "typescript": "6.0.3"
  }
}
