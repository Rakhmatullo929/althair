{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_BRAND_NAME",
        "NEXT_PUBLIC_BRAND_SHORT_NAME",
        "NEXT_PUBLIC_CONTACT_EMAIL",
        "NEXT_PUBLIC_TELEGRAM_URL",
        "NEXT_PUBLIC_APP_URL",
        "LEAD_WEBHOOK_URL",
        "LEAD_WEBHOOK_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
